# Copia este archivo como config/db.local.env y completa los valores.
# Una variable por línea, NOMBRE=valor. El valor puede ir entre comillas simples.

# Cadena de conexión a la base TecnoMantDB. Sin ella la API no arranca.
ConnectionStrings__TecnoMantDB='Server=localhost;Database=TecnoMantDB;User Id=USUARIO;Password=CLAVE;TrustServerCertificate=True'

# Usuario y clave del administrador del portal.
Admin__Usuario=admin
Admin__Clave=CAMBIA_ESTA_CLAVE
