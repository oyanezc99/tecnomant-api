Content-Type: application/json

{ "nombre": "Tecnico Prueba 3", "dni": "10000003", "especialidad": "Ascensores", "usuario": "tec01", "clave": "" }

### 21. DELETE /api/tecnicos/{id} - el técnico creado en la llamada 19 (204)
DELETE {{baseUrl}}/api/tecnicos/{{idTecnicoNuevo}}

### 21a. GET /api/tecnicos/{id} - el técnico ya eliminado (404)
GET {{baseUrl}}/api/tecnicos/{{idTecnicoNuevo}}

### 21b. DELETE /api/tecnicos/{id} - técnico con órdenes (409: "No se puede eliminar: tiene registros relacionados")
DELETE {{baseUrl}}/api/tecnicos/1


### 22. GET /api/ordenes (200: 5 órdenes; la orden 1 trae equipoCodigo "ASC-001" y tecnico "Tecnico Prueba 1")
GET {{baseUrl}}/api/ordenes

### 23. GET /api/ordenes/{id} (200)
GET {{baseUrl}}/api/ordenes/1

### 23a. GET /api/ordenes/{id} - orden que no existe (404)
GET {{baseUrl}}/api/ordenes/999

### 24. POST /api/ordenes - sin estado (201: estado "Pendiente"; el resumen de la llamada 6 cuenta una pendiente más)
POST {{baseUrl}}/api/ordenes
Content-Type: application/json

{ "idEquipo": 2, "idTecnico": 2, "fechaProgramada": "2026-10-25T10:00:00" }

### 24a. POST /api/ordenes - equipo que no existe (400: "idEquipo no corresponde a un equipo existente")
POST {{baseUrl}}/api/ordenes
Content-Type: application/json

{ "idEquipo": 999, "idTecnico": 2, "fechaProgramada": "2026-10-25T10:00:00" }

### 24b. POST /api/ordenes - técnico que no existe (400: "idTecnico no corresponde a un técnico existente")
POST {{baseUrl}}/api/ordenes
Content-Type: application/json

{ "idEquipo": 2, "idTecnico": 999, "fechaProgramada": "2026-10-25T10:00:00" }

### 24c. POST /api/ordenes - estado no permitido (400)
POST {{baseUrl}}/api/ordenes
Content-Type: application/json

{ "idEquipo": 2, "idTecnico": 2, "fechaProgramada": "2026-10-25T10:00:00", "estado": "Cancelada" }

### 24d. POST /api/ordenes - fecha fuera del rango de DATETIME (400)
POST {{baseUrl}}/api/ordenes
Content-Type: application/json

{ "idEquipo": 2, "idTecnico": 2, "fechaProgramada": "1700-01-01T00:00:00" }

### 25. PUT /api/ordenes/{id} - pasa a En proceso (200: la orden actualizada)
PUT {{baseUrl}}/api/ordenes/{{idOrdenNueva}}
Content-Type: application/json

{ "idEquipo": 2, "idTecnico": 2, "fechaProgramada": "2026-10-25T10:00:00", "estado": "En proceso" }

### 25a. PUT /api/ordenes/{id} - sin estado y con otra fecha (200: sigue "En proceso")
PUT {{baseUrl}}/api/ordenes/{{idOrdenNueva}}
Content-Type: application/json

{ "idEquipo": 2, "idTecnico": 2, "fechaProgramada": "2026-10-26T08:30:00" }

### 25b. PUT /api/ordenes/{id} - orden que no existe (404)
PUT {{baseUrl}}/api/ordenes/999
Content-Type: application/json

{ "idEquipo": 2, "idTecnico": 2, "fechaProgramada": "2026-10-25T10:00:00" }

### 26. DELETE /api/ordenes/{id} - la orden creada en la llamada 24 (204)
DELETE {{baseUrl}}/api/ordenes/{{idOrdenNueva}}

### 26a. GET /api/ordenes/{id} - la orden ya eliminada (404)
GET {{baseUrl}}/api/ordenes/{{idOrdenNueva}}

# El borrado de una orden con inspección (409) está en la llamada 3d.


### Ruta que no existe (404 con cuerpo {"mensaje": ...})
GET {{baseUrl}}/api/no-existe
